# stage 4: intermittent fsync stalls (probability per fsync / stall length) at low utilisation, enforce=1.
# 200 writes/s; leader fsyncs ~200/s so p=0.002 gives ~0.4 stalls/s. compare against base.
base_200        200  1 -  -
F1_s300         200  1 -  F1=0.002/300ms
F1_s1000        200  1 -  F1=0.002/1000ms
L_s300          200  1 -  L=0.002/300ms
L_s1000         200  1 -  L=0.002/1000ms
F1F2_s300       200  1 -  F1=0.002/300ms,F2=0.002/300ms
